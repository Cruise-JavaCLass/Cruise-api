          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{jwt_token}}\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/auth/verify-token",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-token"
              ]
            },
            "description": "Introspect active JWT token."
          }
        },
        {
          "name": "Token Refresh Rotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/auth/refresh",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Obtain fresh access token using refresh token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "    var json = pm.response.json();",
                  "    pm.test('Refresh rotation returns valid tokens', function () {",
                  "        pm.expect(json).to.be.an('object');",
                  "        var token = (json.data && json.data.accessToken) || json.accessToken || (json.data && json.data.token) || json.token;",
                  "        pm.expect(token, 'Access token must be present').to.be.a('string').and.not.empty;",
                  "        pm.environment.set('jwt_token', token);",
                  "        var newRefreshToken = (json.data && json.data.refreshToken) || json.refreshToken;",
                  "        if (newRefreshToken) {",
                  "            pm.environment.set('refresh_token', newRefreshToken);",
                  "        }",
                  "        console.log('Successfully rotated and saved jwt_token and refresh_token!');",
                  "    });",
                  "} catch (e) {",
                  "    pm.test('Token refresh response contains valid tokens', function () {",
                  "        pm.expect.fail('Failed to parse refresh response: ' + e.message);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
