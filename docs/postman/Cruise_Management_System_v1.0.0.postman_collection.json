        {
          "name": "Admin Login & Auto-Token Capture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates admin and saves JWT token to environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "    var json = pm.response.json();",
                  "    pm.test('Login returns valid JWT access token', function () {",
                  "        pm.expect(json).to.be.an('object');",
                  "        var token = (json.data && json.data.accessToken) || json.accessToken || (json.data && json.data.token) || json.token;",
                  "        pm.expect(token, 'Access token must be present').to.be.a('string').and.not.empty;",
                  "        pm.environment.set('jwt_token', token);",
                  "        var refreshToken = (json.data && json.data.refreshToken) || json.refreshToken;",
                  "        if (refreshToken) {",
                  "            pm.environment.set('refresh_token', refreshToken);",
                  "        }",
                  "        console.log('Successfully saved jwt_token!');",
                  "    });",
                  "} catch (e) {",
                  "    pm.test('Response is valid JSON containing access token', function () {",
                  "        pm.expect.fail('Failed to parse JSON response or token missing: ' + e.message);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
